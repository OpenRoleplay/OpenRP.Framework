<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageIcon>OpenRoleplay.png</PackageIcon>
    <Title>OpenRP.Framework</Title>
    <Description>OpenRP.Framework is the open source library of Open Roleplay, an ambitious SA-MP roleplay gamemode developed for open.mp (Open Multiplayer, a multiplayer mod for GTA San Andreas) using the SampSharp framework.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/OpenRoleplay/OpenRP.Framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>SampSharp</PackageTags>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://open-roleplay.com/</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="ChatGPT.Net" Version="2.0.0" />
    <PackageReference Include="DSharpPlus" Version="4.5.0" />
    <PackageReference Include="EFCoreSecondLevelCacheInterceptor" Version="5.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.82.0" />
    <PackageReference Include="OpenRP.OpenMp.Streamer" Version="1.0.0-preview.2026.44.2" />
    <PackageReference Include="SampSharp.OpenMp.ColAndreas" Version="1.0.0-preview.2026.44.2" />
    <PackageReference Include="SampSharp.OpenMp.Entities" Version="1.0.0-prerelease2" />
    <PackageReference Include="SampSharp.OpenMp.Entities.Commands" Version="1.0.0-prerelease2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\OpenRoleplay.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
